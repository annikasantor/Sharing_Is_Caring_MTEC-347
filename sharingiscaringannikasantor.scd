// Vocal Warm Up Simulator!!

// Pitch Pipe ( c4 )
(
Pbind(
  \midinote,Pseq([60]),
	\dur, Pseq([2]),
).play
)

// Mama made me mash my M&M's, oh my!
// Solfege: do, re, mi, fa, so, fa, mi, re, do, so, do

// EXAMPLE
(
Pbind(
  \midinote,Pseq([
		60, 62, 64, 65, 67, 65, 64, 62, 60, 67, 60,
	]),
	\dur, Pseq([
		0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 1, 1, 0.5,
	]),
).play
)


