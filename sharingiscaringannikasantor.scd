// Do Do Re Do
// Solfege: do, do, re, do, do, re mi, re, do, do re, mi, fa, mi re, do ect. all the way up the scale
// When you reach the top of the scale, start from high do and sing the same pattern as before, only going down now.

//EXAMPLE
(
Pbind(
  \midinote,Pseq([
		60, 60, 62, 60,
		60, 62, 64, 62, 60
	]),
	\dur, Pseq([
		1, 0.5, 0.5, 1,
		0.5, 0.5, 0.5, 0.5, 1
	]),
).play
)

